# Rename this file to .env.local for local development.
# NEVER commit .env.local to git.
#
# PAYMENT OWNERSHIP: AB Essentia (this app) collects and verifies ALL payments using
# its OWN Paystack account. PayGlobe is only the product/inventory source and the
# order-of-record; it never sees a Paystack key and never touches money.

# ---- Public (exposed to the browser) ----
# Public URL of this Next.js site (used for Paystack callback URLs).
NEXT_PUBLIC_SITE_URL=https://abessentiagh.com

# Public URL of the PayGlobe backend (used by the browser to browse products).
NEXT_PUBLIC_PAYGLOBE_API_URL=https://api.payglobe.net

# PayGlobe store scoping (set EXACTLY one of these):
# NEXT_PUBLIC_STORE_ID is preferred - it scopes the shop to a single store.
# NEXT_PUBLIC_MERCHANT_ID scopes the shop to all stores owned by that merchant.
NEXT_PUBLIC_STORE_ID=
NEXT_PUBLIC_MERCHANT_ID=

# Optional: extra comma-separated image hosts for next/image (CDN/bucket).
NEXT_PUBLIC_IMAGE_HOSTS=

# ---- Server-only secrets (NEVER exposed to the browser) ----
# AB Essentia's own Paystack keys.
PAYSTACK_SECRET_KEY=sk_test_...

# API key issued by PayGlobe to this merchant (scope: create_orders).
PAYGLOBE_API_KEY=...

# PayGlobe external (headless commerce) API base. Defaults to
# ${NEXT_PUBLIC_PAYGLOBE_API_URL}/api/v1/external when omitted.
PAYGLOBE_BASE_URL=https://api.payglobe.net/api/v1/external

# Paystack webhook: set the URL below in the Paystack dashboard so orders are
# fulfilled even if the customer closes their browser after paying:
#   https://abessentiagh.com/api/paystack/webhook
